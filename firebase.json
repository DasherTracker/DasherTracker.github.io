{
  "database": {
    "rules": "database.rules.json"
  },
  "hosting": {
    "target": "dashertracker",
    "public": ".",
    "ignore": [
      "firebase.json",
      "database.rules.json",
      ".firebaserc",
      ".git/**",
      ".firebase/**",
      "**/.*",
      "**/node_modules/**",
      "README.md",
      "CHANGELOG.md"
    ],
    "headers": [
      {
        "source": "**/*.@(js|css|html)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  }
}
